---
const icons = [
	{ name: 'Node.js',     url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg',         cls: 'i-nodejs'    },
	{ name: 'GitHub',      url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg',         cls: 'i-github'    },
	{ name: 'Firebase',    url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/firebase/firebase-plain.svg',        cls: 'i-firebase'  },
	{ name: 'Figma',       url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/figma/figma-original.svg',           cls: 'i-figma'     },
	{ name: 'React',       url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg',           cls: 'i-react'     },
	{ name: 'JavaScript',  url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg', cls: 'i-js'        },
	{ name: 'MUI',         url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/materialui/materialui-original.svg', cls: 'i-mui'       },
	{ name: 'Blender',     url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/blender/blender-original.svg',       cls: 'i-blender'   },
	{ name: 'TypeScript',  url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg', cls: 'i-ts'        },
	{ name: 'Tailwind',    url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg', cls: 'i-tailwind' },
	{ name: 'Sass',        url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/sass/sass-original.svg',             cls: 'i-sass'      },
	{ name: 'CSS3',        url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg',             cls: 'i-css3'      },
	{ name: 'Bootstrap',   url: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/bootstrap/bootstrap-original.svg',   cls: 'i-bootstrap' },
];
---

<section class="hero" id="hero">
	<div class="hero-container">

		<!-- ── Left column ── -->
		<div class="hero-left">
			<p  class="greeting"  id="h-greeting">Hello, I'm</p>
			<h1 class="name"      id="h-name" aria-label="Jussef">
				<span class="ch">J</span><span class="ch">u</span><span class="ch">s</span><span class="ch">s</span><span class="ch">e</span><span class="ch">f</span>
			</h1>
			<p class="subtitle" id="h-subtitle">
				<span class="sym">≥</span><span class="front"> Frontend</span><span class="eng"> Engineer</span>
			</p>
		</div>

		<!-- ── Right column: constellation ── -->
		<div class="hero-right">
			<div class="constellation" id="constellation">

				<!-- Tech icons -->
				{icons.map((icon, i) => (
					<img
						src={icon.url}
						alt={icon.name}
						class={`ticon ${icon.cls}`}
						style={`--fd: ${(i * 0.65).toFixed(2)}s`}
					/>
				))}

				<!-- Central badge -->
				<img
					src="/img/badge.png"
					alt="JussDev Frontend"
					class="badge"
					id="h-badge"
				/>
			</div>
		</div>

	</div>
</section>

<script>
	import { gsap } from 'gsap';

	gsap.set('#h-greeting', { opacity: 0, y: 28 });
	gsap.set('.ch',         { opacity: 0, y: 40, rotateX: -70, filter: 'blur(6px)' });
	gsap.set('#h-subtitle', { opacity: 0, y: 20 });
	gsap.set('#h-badge',    { opacity: 0, scale: 0.75 });
	gsap.set('.ticon',      { opacity: 0, scale: 0.4 });

	const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

	tl
		.to('#h-greeting', { opacity: 1, y: 0, duration: 0.7 }, 0.2)
		.to('.ch', {
			opacity: 1, y: 0, rotateX: 0, filter: 'blur(0px)',
			duration: 0.9,
			stagger: { each: 0.07, from: 'start' }
		}, 0.45)
		.to('#h-subtitle', { opacity: 1, y: 0, duration: 0.7 }, 0.85)
		.to('#h-badge', {
			opacity: 1, scale: 1, duration: 0.9,
			ease: 'back.out(1.5)'
		}, 0.55)
		.to('.ticon', {
			opacity: 1, scale: 1, duration: 0.45,
			stagger: { each: 0.055, from: 'random' }
		}, 0.9);

	// Hover sparkle on name characters
	document.querySelectorAll('.ch').forEach(ch => {
		ch.addEventListener('mouseenter', () =>
			gsap.to(ch, { y: -8, scale: 1.15, color: '#fff', duration: 0.25, ease: 'power2.out' }));
		ch.addEventListener('mouseleave', () =>
			gsap.to(ch, { y: 0, scale: 1, color: '#f07830', duration: 0.25, ease: 'power2.in' }));
	});
</script>

<style>
	/* ── Section ── */
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 7rem 3rem 3rem;
	}

	.hero-container {
		max-width: 1200px;
		margin: 0 auto;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1.25fr;
		gap: 3rem;
		align-items: center;
	}

	/* ── Left column ── */
	.hero-left {
		display: flex;
		flex-direction: column;
	}

	.greeting {
		font-family: 'Poppins', sans-serif;
		font-size: clamp(1.4rem, 2.8vw, 2.1rem);
		font-weight: 700;
		color: var(--text-primary);
		margin: 0 0 0.1rem;
		line-height: 1.2;
	}

	.name {
		font-family: 'Poppins', sans-serif;
		font-size: clamp(3.5rem, 9vw, 6.5rem);
		font-weight: 800;
		color: var(--accent-orange);
		margin: 0 0 0.65rem;
		line-height: 1;
		letter-spacing: -0.02em;
		display: flex;
		perspective: 800px;
	}

	.ch {
		display: inline-block;
		will-change: transform, opacity, filter;
		transform-style: preserve-3d;
		cursor: default;
	}

	.subtitle {
		font-family: 'Poppins', sans-serif;
		font-size: clamp(1.1rem, 2.5vw, 1.75rem);
		font-weight: 500;
		margin: 0;
		line-height: 1.3;
	}

	.sym   { color: var(--accent-orange); font-family: 'Fira Code', monospace; font-weight: 600; }
	.front { color: var(--accent-cyan);   font-family: 'Fira Code', monospace; font-weight: 500; }
	.eng   { color: var(--text-primary);  font-weight: 400; font-family: 'Poppins', sans-serif; }

	/* ── Right column ── */
	.hero-right {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.constellation {
		position: relative;
		width: 560px;
		height: 420px;
		overflow: visible;
	}

	/* ── Central badge ── */
	.badge {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 230px;
		height: auto;
		z-index: 10;
		filter: drop-shadow(0 0 18px rgba(240, 120, 48, 0.35));
		animation: badgePulse 4s ease-in-out infinite alternate;
	}

	@keyframes badgePulse {
		from { filter: drop-shadow(0 0 12px rgba(240, 120, 48, 0.3)); }
		to   { filter: drop-shadow(0 0 28px rgba(45, 212, 192, 0.45)); }
	}

	/* ── Tech icons shared ── */
	.ticon {
		position: absolute;
		width: 52px;
		height: 52px;
		border-radius: 10px;
		animation: floatIcon 4s ease-in-out infinite;
		animation-delay: var(--fd, 0s);
		filter: drop-shadow(0 3px 10px rgba(0, 0, 0, 0.45));
		transition: transform 0.25s ease, filter 0.25s ease;
		cursor: default;
	}

	.ticon:hover {
		transform: scale(1.25) translateY(-4px) !important;
		filter: drop-shadow(0 6px 16px rgba(45, 212, 192, 0.4));
		animation-play-state: paused;
	}

	/* GitHub is dark — make it white */
	.i-github { filter: invert(1) drop-shadow(0 3px 10px rgba(0,0,0,.45)); }
	.i-github:hover { filter: invert(1) drop-shadow(0 6px 16px rgba(45, 212, 192, 0.4)); }

	@keyframes floatIcon {
		0%, 100% { transform: translateY(0); }
		50%       { transform: translateY(-9px); }
	}

	/* ── Icon positions (% of 560×420 container) ── */
	.i-nodejs    { top:  9%; left: 16%; }
	.i-github    { top:  2%; left: 34%; }
	.i-firebase  { top:  7%; left: 53%; }
	.i-figma     { top: 17%; left: 71%; }
	.i-react     { top: 40%; left:  2%; }
	.i-js        { top: 63%; left: 11%; }
	.i-mui       { top: 40%; left: 81%; }
	.i-blender   { top: 29%; left: 91%; }
	.i-ts        { top: 79%; left:  6%; }
	.i-tailwind  { top: 84%; left: 24%; }
	.i-sass      { top: 87%; left: 43%; }
	.i-css3      { top: 81%; left: 62%; }
	.i-bootstrap { top: 77%; left: 79%; }

	/* ── Responsive ── */
	@media (max-width: 1024px) {
		.hero-container {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.hero-left { align-items: center; }
		.name { justify-content: center; }
		.constellation { width: 380px; height: 290px; }
		.ticon { width: 40px; height: 40px; }
		.badge { width: 170px; }
	}

	@media (max-width: 600px) {
		.hero { padding: 6rem 1.5rem 2rem; }
		.constellation { width: 300px; height: 230px; }
		.ticon { width: 32px; height: 32px; border-radius: 6px; }
		.badge { width: 135px; }
	}
</style>
