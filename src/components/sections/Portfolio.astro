---
// Portfolio section
const projects = [
	{
		title: 'Mini Widgets Collection',
		desc: 'Una colección de mini widgets interactivos diseñados para ser incrustados como iframe',
		descEN: 'A collection of mini interactive widgets designed to be embedded as iframes',
		tags: ['React', 'TypeScript', 'Vite'],
		href: 'https://mini-widgets.vercel.app/',
		src: 'img/portfolio/mini.png',
	},
	{
		title: 'Subscription Manager',
		desc: 'Una aplicación web para gestionar suscripciones y pagos recurrentes con recordatorios automáticos',
		descEN: 'A web application for managing subscriptions and recurring payments with automatic reminders',
		tags: ['React', 'TypeScript', 'Vite', 'Node.js'],
		href: 'https://subs.juss.dev/',
		src: 'img/portfolio/subs.png',
	},
	{
		title: 'Portfolio Terminal',
		desc: 'Un portafolio interactivo con estilo de terminal y windows 98, construido con Astro y TypeScript',
		descEN: 'An interactive portfolio with a terminal and Windows 98 style, built with Astro and TypeScript',
		tags: ['Astro', 'JavaScript', 'React', 'Tailwind'],
		href: 'https://www.depredador.app/',
		src: 'img/portfolio/term.png',
	},
	{
		title: 'ESP32 Projects',
		desc: 'Una colección de proyectos y tutoriales para el microcontrolador ESP32, incluyendo IoT y automatización',
		descEN: 'A collection of projects and tutorials for the ESP32 microcontroller, including IoT and automation',
		tags: ['ESP32', 'IoT', 'Automation', 'Astro'],
		href: 'https://elegoo-esp32-proyectos.vercel.app/',
		src: 'img/portfolio/esp32.png',
	},
	{
		title: 'Project Four',
		desc: 'algun connect',
		descEN: 'Some connect',
		tags: ['CSS3', 'JavaScript'],
		href: '#',
		src: '',
	},
	{
		title: 'Project Five',
		desc: 'revisar algo de depredador apps',
		descEN: 'Review some predator apps',
		tags: ['CSS3', 'JavaScript'],
		href: '#',
		src: '',
	},
];
---

<section class="portfolio" id="portfolio">
	<div class="portfolio-wrap">

		<div class="portfolio-header">
			<p
				class="section-label"
				id="portfolio-label"
				data-en="≥ Portfolio"
				data-es="≥ Portafolio"
			>≥ Portfolio</p>
			<img
				src="/img/portfolio/avatar-dev.png"
				alt="Avatar dev"
				class="portfolio-avatar"
				id="portfolio-avatar"
			/>
		</div>

		<div class="projects-grid">
			{projects.map((p, i) => (
				<a
					href={p.href}
					target="_blank"
					rel="noopener noreferrer"
					class="project-card"
					data-fade
					style={`--delay: ${Math.floor(i / 2) * 0.15}s;`}
				>
					<div class="project-img-wrap">
						{p.src
							? <img src={p.src} alt={p.title} class="project-img" />
							: <div class="project-img-placeholder" />
						}
					</div>
					<div class="project-info">
						<h3 class="project-title">{p.title}</h3>
						<p class="project-desc">{p.desc}</p>
						<ul class="project-tags">
							{p.tags.map(tag => <li data-tag={tag.toLowerCase().replaceAll("+", "p").replace(/[^a-z0-9]/g, "")}>{tag}</li>)}
						</ul>
					</div>
				</a>
			))}
		</div>

	</div>
</section>

<script>
	import { gsap } from 'gsap';

	const labelEl = document.querySelector<HTMLElement>('#portfolio-label');
	let labelVisible = false;

	function renderLabel(lang: 'en' | 'es') {
		if (!labelEl) return;
		const text = (lang === 'es' ? labelEl.dataset.es : labelEl.dataset.en) ?? labelEl.textContent ?? '';
		labelEl.innerHTML = [...text]
			.map(ch => `<span class="pl">${ch === ' ' ? '&nbsp;' : ch}</span>`)
			.join('');
		const letters = labelEl.querySelectorAll<HTMLElement>('.pl');
		if (labelVisible) {
			gsap.set(letters, { opacity: 1, y: 0, rotateX: 0 });
		} else {
			gsap.set(letters, { opacity: 0, y: 18, rotateX: -80 });
		}
	}

	if (labelEl) {
		const initialLang = localStorage.getItem('site-lang') === 'es' ? 'es' : 'en';
		renderLabel(initialLang);
		window.addEventListener('langchange', (e) => {
			renderLabel((e as CustomEvent<{ lang: 'en' | 'es' }>).detail.lang);
		});
	}

	const fadeEls = Array.from(document.querySelectorAll<HTMLElement>('.portfolio [data-fade]'));
	const avatarEl = document.getElementById('portfolio-avatar') as HTMLElement | null;

	const visObs = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			const delay = parseFloat(
				(entry.target as HTMLElement).style.getPropertyValue('--delay') || '0'
			) * 1000;
			if (entry.isIntersecting) {
				setTimeout(() => (entry.target as HTMLElement).classList.add('visible'), delay);
			} else {
				(entry.target as HTMLElement).classList.remove('visible');
			}
		});
	}, { threshold: 0.1 });

	fadeEls.forEach(el => visObs.observe(el));

	if (avatarEl) {
		const avatarObs = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					avatarEl.classList.add('visible');
				} else {
					avatarEl.classList.remove('visible');
				}
			});
		}, { threshold: 0.15 });
		avatarObs.observe(avatarEl);
	}

	if (labelEl) {
		const labelObs = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				labelVisible = entry.isIntersecting;
				const letters = entry.target.querySelectorAll<HTMLElement>('.pl');
				if (entry.isIntersecting) {
					gsap.to(letters, {
						opacity: 1, y: 0, rotateX: 0,
						duration: 0.5, stagger: 0.07,
						ease: 'power3.out',
					});
				} else {
					gsap.set(letters, { opacity: 0, y: 18, rotateX: -80 });
				}
			});
		}, { threshold: 0.15 });
		labelObs.observe(labelEl);
	}
</script>

<style>
	.portfolio {
		position: relative;
		padding: 7rem 3rem;
	}

	.portfolio-wrap {
		max-width: 1100px;
		margin: 0 auto;
	}

	/* Header row: label + avatar */
	.portfolio-header {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin: 0 0 3.5rem;
	}

	.section-label {
		font-family: var(--font-main);
		font-size: 1rem;
		font-weight: 500;
		color: var(--accent-orange);
		margin: 0;
		letter-spacing: 0.04em;
		perspective: 600px;
	}

	/* Avatar */
	.portfolio-avatar {
		height: 180px;
		width: auto;
		display: block;
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.8s ease 0.2s, transform 0.8s ease 0.2s;
		animation: float 3.6s ease-in-out infinite;
		animation-play-state: paused;
		filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.5));
	}

	.portfolio-avatar.visible {
		opacity: 1;
		transform: translateY(0);
		animation-play-state: running;
	}

	@keyframes float {
		0%   { transform: translateY(0); }
		50%  { transform: translateY(-10px); }
		100% { transform: translateY(0); }
	}

	.pl {
		display: inline-block;
		will-change: transform, opacity;
	}

	/* Grid — pairs of centered cards */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(280px, 380px));
		gap: 2rem;
		justify-content: center;
	}

	/* Lone trailing card (odd total) spans both columns, centered */
	.project-card:nth-last-child(1):nth-child(odd) {
		grid-column: 1 / -1;
		justify-self: center;
		width: 100%;
		max-width: 380px;
	}

	/* Card */
	.project-card {
		display: flex;
		flex-direction: column;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
	}

	.project-card:hover {
		border-color: var(--accent-orange);
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
	}

	/* Image */
	.project-img-wrap {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.05);
	}

	.project-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.project-card:hover .project-img {
		transform: scale(1.04);
	}

	.project-img-placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
	}

	/* Info */
	.project-info {
		padding: 1.25rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.project-title {
		font-family: var(--font-main);
		font-size: 1rem;
		font-weight: 600;
		color: #e8eaf0;
		margin: 0;
	}

	.project-desc {
		font-size: 0.875rem;
		line-height: 1.6;
		color: #8a93a8;
		margin: 0;
	}

	/* Tags */
	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0.4rem 0 0;
		padding: 0;
	}

	.project-tags li {
		font-family: var(--font-main);
		font-size: 0.72rem;
		font-weight: 500;
		--tag-color: var(--accent-orange);
		color: var(--tag-color);
		background: color-mix(in srgb, var(--tag-color) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--tag-color) 30%, transparent);
		border-radius: 4px;
		padding: 0.15rem 0.55rem;
		letter-spacing: 0.03em;
	}

	/* Tag colors per technology (brand palette) */
	.project-tags li[data-tag="react"]      { --tag-color: #61dafb; }
	.project-tags li[data-tag="typescript"] { --tag-color: #3178c6; }
	.project-tags li[data-tag="javascript"] { --tag-color: #f7df1e; }
	.project-tags li[data-tag="vite"]       { --tag-color: #a259ff; }
	.project-tags li[data-tag="nodejs"]     { --tag-color: #6cc24a; }
	.project-tags li[data-tag="astro"]      { --tag-color: #ff5d01; }
	.project-tags li[data-tag="css3"]       { --tag-color: #56a8ff; }
	.project-tags li[data-tag="html5"]      { --tag-color: #e34f26; }
	.project-tags li[data-tag="tailwind"]   { --tag-color: #38bdf8; }
	.project-tags li[data-tag="sass"]       { --tag-color: #cf649a; }
	.project-tags li[data-tag="python"]     { --tag-color: #ffd43b; }
	.project-tags li[data-tag="gsap"]       { --tag-color: #88ce02; }
	.project-tags li[data-tag="nextjs"]     { --tag-color: #e8eaf0; }
	.project-tags li[data-tag="vuejs"]      { --tag-color: #42b883; }
	.project-tags li[data-tag="php"]        { --tag-color: #8993be; }
	.project-tags li[data-tag="mongodb"]    { --tag-color: #4faa41; }
	.project-tags li[data-tag="firebase"]   { --tag-color: #ffca28; }
	.project-tags li[data-tag="supabase"]   { --tag-color: #3ecf8e; }
	.project-tags li[data-tag="arduino"]    { --tag-color: #00979d; }
	.project-tags li[data-tag="esp32"]      { --tag-color: #e7352c; }
	.project-tags li[data-tag="cpp"]        { --tag-color: #649ad2; }

	/* data-fade — cards rise up from below and settle in place */
	[data-fade] {
		opacity: 0;
		transform: translateY(90px);
		transition: opacity 0.8s ease, transform 0.8s ease;
	}

	[data-fade].visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 768px) {
		.portfolio { padding: 5rem 1.5rem; }
		.projects-grid { grid-template-columns: minmax(0, 420px); }
		.project-card:nth-last-child(1):nth-child(odd) { max-width: 420px; }
	}
</style>
