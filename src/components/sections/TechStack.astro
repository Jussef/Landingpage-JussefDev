---
// Sección Tech Stack - Tecnologías frontend core
const technologies = [
	{ name: 'HTML', level: 'Fundamento' },
	{ name: 'CSS', level: 'Fundamento' },
	{ name: 'JavaScript', level: 'Core' },
	{ name: 'TypeScript', level: 'Core' },
	{ name: 'React', level: 'Framework' },
	{ name: 'Astro', level: 'Framework' },
];
---

<section class="tech-stack">
	<div class="tech-stack-content">
		<p class="tech-label" data-animate>Stack</p>
		<div class="tech-grid">
			{technologies.map((tech, i) => (
				<div class="tech-item" data-animate style={`--delay: ${i * 0.1}s`}>
					<span class="tech-name">{tech.name}</span>
					<span class="tech-level">{tech.level}</span>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	const techElements = document.querySelectorAll('.tech-stack [data-animate]');

	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('visible');
			}
		});
	}, {
		threshold: 0.1,
		rootMargin: '0px 0px -30px 0px'
	});

	techElements.forEach(el => observer.observe(el));
</script>

<style>
	.tech-stack {
		position: relative;
		z-index: 10;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #0a0a0a;
		padding: 6rem 2rem;
	}

	.tech-stack-content {
		width: 100%;
		max-width: 900px;
	}

	.tech-label {
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #525252;
		margin: 0 0 3rem;
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	.tech-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		background-color: #262626;
		border: 1px solid #262626;
	}

	.tech-item {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 2rem 1.5rem;
		background-color: #0a0a0a;
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.6s ease-out var(--delay, 0s),
		            transform 0.6s ease-out var(--delay, 0s),
		            background-color 0.3s ease;
	}

	.tech-item:hover {
		background-color: #171717;
	}

	.tech-name {
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		font-weight: 300;
		color: #fafafa;
		letter-spacing: -0.01em;
	}

	.tech-level {
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #525252;
	}

	[data-animate].visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 640px) {
		.tech-stack {
			padding: 4rem 1rem;
		}

		.tech-grid {
			grid-template-columns: 1fr;
		}

		.tech-item {
			padding: 1.5rem 1.25rem;
		}

		.tech-label {
			margin-bottom: 2rem;
		}
	}
</style>
