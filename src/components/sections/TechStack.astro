---
// Skills & Tech — album-cover style cards
const albums = [
	{ src: '/img/js-album.png',   alt: 'JavaScript ECMAScript', label: 'JavaScript' },
	{ src: '/img/html5-album.png', alt: 'HTML5 Remarkable Hits', label: 'HTML5'      },
];
---

<section class="skills" id="skills">
	<div class="skills-wrap">

		<p class="section-label" data-fade>≥ Skills &amp; technologist</p>

		<div class="albums-row">
			{albums.map((album, i) => (
				<div
					class="album-card"
					data-fade
					style={`--delay: ${i * 0.12}s`}
				>
					<img src={album.src} alt={album.alt} class="album-img" />
					<p class="album-name">{album.label}</p>
				</div>
			))}
		</div>

	</div>
</section>

<script>
	const els = document.querySelectorAll('.skills [data-fade]');

	const obs = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				const delay = parseFloat(
					(entry.target as HTMLElement).style.getPropertyValue('--delay') || '0'
				) * 1000;
				setTimeout(() => entry.target.classList.add('visible'), delay);
				obs.unobserve(entry.target);
			}
		});
	}, { threshold: 0.1 });

	els.forEach(el => obs.observe(el));
</script>

<style>
	.skills {
		padding: 7rem 3rem 9rem;
		background-color: var(--bg);
	}

	.skills-wrap {
		max-width: 1100px;
		margin: 0 auto;
	}

	/* Section label */
	.section-label {
		font-family: 'Poppins', sans-serif;
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--accent-orange);
		margin: 0 0 3.5rem;
		letter-spacing: 0.04em;
	}

	/* Album row */
	.albums-row {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
	}

	/* Album card */
	.album-card {
		width: 180px;
		cursor: default;
		opacity: 0;
		transform: translateY(28px);
		transition:
			opacity  0.65s ease,
			transform 0.65s ease;
	}

	.album-card.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.album-img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 6px;
		display: block;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
	}

	.album-card:hover .album-img {
		transform: translateY(-8px) scale(1.03);
		box-shadow: 0 14px 32px rgba(0, 0, 0, 0.6);
	}

	.album-name {
		font-size: 0.82rem;
		color: var(--text-muted);
		text-align: center;
		margin: 0.7rem 0 0;
	}

	/* data-fade shared */
	[data-fade] {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}

	[data-fade].visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 640px) {
		.skills { padding: 5rem 1.5rem 6rem; }
		.album-card { width: 140px; }
	}
</style>
