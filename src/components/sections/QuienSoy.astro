---
// About section
---

<section class="about" id="about">
	<div class="about-wrap">

		<p class="section-label" id="about-label">≥ About</p>

		<div class="about-grid">
			<div class="about-img-col" data-slide>
				<img src="/img/about.png" alt="Jussef — React superhero" class="about-img" />
			</div>

			<div class="about-text-col">
				<p data-fade>
					Hi! I'm a developer who loves sharing and teaching what I've learned.
					I have over 6 years of experience building web applications.
				</p>
				<p data-fade>
					I'm passionate about staying up to date with the latest technologies —
					I truly believe that one day we'll see robots just like in the movies,
					and that's one of the reasons I love programming.
				</p>
				<p data-fade>
					I'm also a big fan of 80s pop culture and the cyberpunk aesthetic.
				</p>

				<div class="lang-toggle" data-fade>
					<span class="lang-label">EN</span>
					<label class="switch">
						<input class="toggle" type="checkbox" id="lang-switch" />
						<span class="slider"></span>
						<span class="card-side"></span>
					</label>
					<span class="lang-label">ES</span>
				</div>
			</div>
		</div>

	</div>
</section>

<script>
	import { gsap } from 'gsap';

	// Split label into character spans
	const labelEl = document.querySelector<HTMLElement>('#about-label');
	if (labelEl) {
		const text = labelEl.textContent ?? '';
		labelEl.innerHTML = [...text]
			.map(ch => `<span class="al">${ch === ' ' ? '&nbsp;' : ch}</span>`)
			.join('');
		gsap.set('.al', { opacity: 0, y: 18, rotateX: -80 });
	}

	// Observe image + paragraphs — add AND remove .visible on scroll
	const slideEl  = document.querySelector<HTMLElement>('.about [data-slide]');
	const fadeEls  = Array.from(document.querySelectorAll<HTMLElement>('.about [data-fade]'));
	const allEls   = [slideEl, ...fadeEls].filter(Boolean) as HTMLElement[];

	const visObs = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			const delay = allEls.indexOf(entry.target as HTMLElement) * 100;
			if (entry.isIntersecting) {
				setTimeout(() => (entry.target as HTMLElement).classList.add('visible'), delay);
			} else {
				(entry.target as HTMLElement).classList.remove('visible');
			}
		});
	}, { threshold: 0.15 });

	allEls.forEach(el => visObs.observe(el));

	// Language toggle — EN ↔ ES
	const langSwitch = document.getElementById('lang-switch') as HTMLInputElement | null;
	if (langSwitch) {
		const paras = Array.from(document.querySelectorAll<HTMLElement>('.about-text-col p[data-fade]'));
		const texts = [
			{
				en: "Hi! I'm a developer who loves sharing and teaching what I've learned. I have over 6 years of experience building web applications.",
				es: "¡Hola! Soy un desarrollador que ama compartir y enseñar lo que he aprendido. Tengo más de 6 años de experiencia construyendo aplicaciones web."
			},
			{
				en: "I'm passionate about staying up to date with the latest technologies — I truly believe that one day we'll see robots just like in the movies, and that's one of the reasons I love programming.",
				es: "Me apasiona mantenerme al día con las últimas tecnologías — realmente creo que algún día veremos robots tal como en las películas, y esa es una de las razones por las que amo la programación."
			},
			{
				en: "I'm also a big fan of 80s pop culture and the cyberpunk aesthetic.",
				es: "También soy un gran fan de la cultura pop de los 80s y la estética cyberpunk."
			}
		];
		langSwitch.addEventListener('change', () => {
			const lang = langSwitch.checked ? 'es' : 'en';
			paras.forEach((p, i) => { p.textContent = texts[i][lang]; });
		});
	}

	// Letter animation for label — in on enter, reset on leave
	if (labelEl) {
		const labelObs = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				const letters = entry.target.querySelectorAll<HTMLElement>('.al');
				if (entry.isIntersecting) {
					gsap.to(letters, {
						opacity: 1, y: 0, rotateX: 0,
						duration: 0.5, stagger: 0.07,
						ease: 'power3.out',
					});
				} else {
					gsap.set(letters, { opacity: 0, y: 18, rotateX: -80 });
				}
			});
		}, { threshold: 0.15 });
		labelObs.observe(labelEl);
	}
</script>

<style>
	.about {
		padding: 7rem 3rem;
		background-color: var(--bg);
	}

	.about-wrap {
		max-width: 1100px;
		margin: 0 auto;
	}

	/* Section label */
	.section-label {
		font-family: var(--font-main);
		font-size: 1rem;
		font-weight: 500;
		color: var(--accent-orange);
		margin: 0 0 3.5rem;
		letter-spacing: 0.04em;
		perspective: 600px;
	}

	.al {
		display: inline-block;
		will-change: transform, opacity;
	}

	/* Grid */
	.about-grid {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 4.5rem;
		align-items: start;
	}

	/* Image column */
	.about-img-col {
		opacity: 0;
		transform: translateX(-36px);
		transition: opacity 0.85s ease, transform 0.85s ease;
	}

	.about-img-col.visible {
		opacity: 1;
		transform: translateX(0);
	}

	.about-img {
		width: 240px;
		display: block;
		border-radius: 12px;
	}

	/* Text column */
	.about-text-col p {
		font-size: clamp(0.95rem, 1.7vw, 1.1rem);
		line-height: 1.8;
		color: #c8d0e0;
		margin: 0 0 1.5rem;
	}

	.about-text-col p:last-child { margin-bottom: 0; }

	/* data-fade shared */
	[data-fade] {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}

	[data-fade].visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Lang toggle */
	.lang-toggle {
		display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    justify-content: center;
    margin-left: -90px;
	}

	.lang-label {
		font-family: var(--font-main);
		font-size: 0.85rem;
		font-weight: 600;
		color: #c8d0e0;
		letter-spacing: 0.05em;
	}

	.switch {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 30px;
		width: 60px;
		height: 26px;
	}

	.toggle {
		opacity: 0;
		width: 0;
		height: 0;
	}

	.slider {
		image-rendering: pixelated;
		position: absolute;
		cursor: pointer;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: url('/img/boton/off.png');
		background-size: 100% 100%;
		transition: 0.3s;
	}

	.slider:before {
		box-sizing: border-box;
		position: absolute;
		content: "";
		height: 32px;
		width: 28px;
		bottom: 0px;
		background: url('/img/boton/btn.png');
		background-size: 28px 32px;
		transition: 0.3s;
	}

	.toggle:checked + .slider {
		background: url('/img/boton/on.png');
		background-size: 100% 100%;
	}

	.toggle:checked + .slider:before {
		transform: translateX(32px);
	}

	@media (max-width: 768px) {
		.about { padding: 5rem 1.5rem; }
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.about-img { width: 200px; margin: 0 auto; }
	}
</style>
