---
// About section
---

<section class="about" id="about">
	<div class="about-wrap">

		<p
			class="section-label"
			id="about-label"
			data-en="≥ About"
			data-es="≥ Sobre mí"
		>≥ About</p>

		<div class="about-grid">
			<div class="about-img-col" data-slide>
				<img src="/img/about.png" alt="Jussef — React superhero" class="about-img" />
			</div>

			<div class="about-text-col">
				<p
					data-fade
					data-i18n
					data-en="I'm a web developer focused on building modern applications that go beyond just the interface."
					data-es="Soy desarrollador web enfocado en crear aplicaciones modernas que no se quedan solo en la interfaz."
				>I'm a web developer focused on building modern applications that go beyond just the interface.</p>
				<p
					data-fade
					data-i18n
					data-en="I work with React, Astro, Firebase, Vercel, Google Cloud, Docker, and more to build clear, functional experiences — connecting apps to real authentication and data, and handling everything needed to ship them to production in the cloud."
					data-es="Trabajo con React, Astro, Firebase, Vercel, Google Cloud, Docker y más, para construir experiencias claras y funcionales, conecto aplicaciones con autenticación y datos reales, y gestiono el proceso necesario para llevarlas a producción en la nube."
				>I work with React, Astro, Firebase, Vercel, Google Cloud, Docker, and more to build clear, functional experiences — connecting apps to real authentication and data, and handling everything needed to ship them to production in the cloud.</p>
				<p
					data-fade
					data-i18n
					data-en="I like understanding how every part of a project works and solving the challenges along the way: from structuring the UI and wiring up services to configuring deployments, containers, and production environments."
					data-es="Me gusta entender cómo funciona cada parte del proyecto y resolver los retos que aparecen en el camino: desde estructurar la interfaz y conectar servicios hasta configurar despliegues, contenedores y entornos de producción."
				>I like understanding how every part of a project works and solving the challenges along the way: from structuring the UI and wiring up services to configuring deployments, containers, and production environments.</p>
				<p
					data-fade
					data-i18n
					data-en="My goal is simple: turn ideas into applications that actually work."
					data-es="Mi objetivo es simple: convertir ideas en aplicaciones que realmente funcionen."
				>My goal is simple: turn ideas into applications that actually work.</p>

				<div class="lang-toggle" data-fade>
					<span class="lang-label">EN</span>
					<label class="switch">
						<input class="toggle" type="checkbox" id="lang-switch" />
						<span class="slider"></span>
						<span class="card-side"></span>
					</label>
					<span class="lang-label">ES</span>
				</div>
			</div>
		</div>

	</div>
</section>

<script>
	import { gsap } from 'gsap';

	// Split label into character spans — re-run whenever the language changes
	const labelEl = document.querySelector<HTMLElement>('#about-label');
	let labelVisible = false;

	function renderLabel(lang: 'en' | 'es') {
		if (!labelEl) return;
		const text = (lang === 'es' ? labelEl.dataset.es : labelEl.dataset.en) ?? labelEl.textContent ?? '';
		labelEl.innerHTML = [...text]
			.map(ch => `<span class="al">${ch === ' ' ? '&nbsp;' : ch}</span>`)
			.join('');
		const letters = labelEl.querySelectorAll<HTMLElement>('.al');
		if (labelVisible) {
			gsap.set(letters, { opacity: 1, y: 0, rotateX: 0 });
		} else {
			gsap.set(letters, { opacity: 0, y: 18, rotateX: -80 });
		}
	}

	if (labelEl) {
		const initialLang = localStorage.getItem('site-lang') === 'es' ? 'es' : 'en';
		renderLabel(initialLang);
		window.addEventListener('langchange', (e) => {
			renderLabel((e as CustomEvent<{ lang: 'en' | 'es' }>).detail.lang);
		});
	}

	// Observe image + paragraphs — add AND remove .visible on scroll
	const slideEl  = document.querySelector<HTMLElement>('.about [data-slide]');
	const fadeEls  = Array.from(document.querySelectorAll<HTMLElement>('.about [data-fade]'));
	const allEls   = [slideEl, ...fadeEls].filter(Boolean) as HTMLElement[];

	const visObs = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			const delay = allEls.indexOf(entry.target as HTMLElement) * 100;
			if (entry.isIntersecting) {
				setTimeout(() => (entry.target as HTMLElement).classList.add('visible'), delay);
			} else {
				(entry.target as HTMLElement).classList.remove('visible');
			}
		});
	}, { threshold: 0.15 });

	allEls.forEach(el => visObs.observe(el));

	// Letter animation for label — in on enter, reset on leave
	if (labelEl) {
		const labelObs = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				labelVisible = entry.isIntersecting;
				const letters = entry.target.querySelectorAll<HTMLElement>('.al');
				if (entry.isIntersecting) {
					gsap.to(letters, {
						opacity: 1, y: 0, rotateX: 0,
						duration: 0.5, stagger: 0.07,
						ease: 'power3.out',
					});
				} else {
					gsap.set(letters, { opacity: 0, y: 18, rotateX: -80 });
				}
			});
		}, { threshold: 0.15 });
		labelObs.observe(labelEl);
	}
</script>

<style>
	.about {
		position: relative;
		padding: 7rem 3rem;
	}

	.about-wrap {
		max-width: 1100px;
		margin: 0 auto;
	}

	/* Section label */
	.section-label {
		font-family: var(--font-main);
		font-size: 1rem;
		font-weight: 500;
		color: var(--accent-orange);
		margin: 0 0 3.5rem;
		letter-spacing: 0.04em;
		perspective: 600px;
	}

	.al {
		display: inline-block;
		will-change: transform, opacity;
	}

	/* Grid */
	.about-grid {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 4.5rem;
		align-items: start;
	}

	/* Image column */
	.about-img-col {
		opacity: 0;
		transform: translateX(-36px);
		transition: opacity 0.85s ease, transform 0.85s ease;
	}

	.about-img-col.visible {
		opacity: 1;
		transform: translateX(0);
	}

	.about-img {
		width: 240px;
		display: block;
		border-radius: 12px;
	}

	/* Text column */
	.about-text-col p {
		font-size: clamp(0.95rem, 1.7vw, 1.1rem);
		line-height: 1.8;
		color: #c8d0e0;
		margin: 0 0 1.5rem;
	}

	.about-text-col p:last-child { margin-bottom: 0; }

	/* data-fade shared */
	[data-fade] {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}

	[data-fade].visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Lang toggle */
	.lang-toggle {
		display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    justify-content: center;
    margin-left: -90px;
	}

	.lang-label {
		font-family: var(--font-main);
		font-size: 0.85rem;
		font-weight: 600;
		color: #c8d0e0;
		letter-spacing: 0.05em;
	}

	.switch {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 30px;
		width: 60px;
		height: 26px;
	}

	.toggle {
		opacity: 0;
		width: 0;
		height: 0;
	}

	.slider {
		image-rendering: pixelated;
		position: absolute;
		cursor: pointer;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: url('/img/boton/off.png');
		background-size: 100% 100%;
		transition: 0.3s;
	}

	.slider:before {
		box-sizing: border-box;
		position: absolute;
		content: "";
		height: 32px;
		width: 28px;
		bottom: 0px;
		background: url('/img/boton/btn.png');
		background-size: 28px 32px;
		transition: 0.3s;
	}

	.toggle:checked + .slider {
		background: url('/img/boton/on.png');
		background-size: 100% 100%;
	}

	.toggle:checked + .slider:before {
		transform: translateX(32px);
	}

	@media (max-width: 768px) {
		.about { padding: 5rem 1.5rem; }
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.about-img { width: 200px; margin: 0 auto; }
	}
</style>
