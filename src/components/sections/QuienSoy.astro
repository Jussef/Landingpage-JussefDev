---
// About section
---

<section class="about" id="about">
	<div class="about-wrap">

		<p class="section-label" data-fade>≥ About</p>

		<div class="about-grid">
			<div class="about-img-col" data-slide>
				<img src="/img/about.png" alt="Jussef — React superhero" class="about-img" />
			</div>

			<div class="about-text-col">
				<p data-fade>
					Hi! I'm a developer who loves sharing and teaching what I've learned.
					I have over 6 years of experience building web applications.
				</p>
				<p data-fade>
					I'm passionate about staying up to date with the latest technologies —
					I truly believe that one day we'll see robots just like in the movies,
					and that's one of the reasons I love programming.
				</p>
				<p data-fade>
					I'm also a big fan of 80s pop culture and the cyberpunk aesthetic.
				</p>
			</div>
		</div>

	</div>
</section>

<script>
	const fadeEls = document.querySelectorAll('.about [data-fade]');
	const slideEl = document.querySelector<HTMLElement>('.about [data-slide]');

	const fadeObs = new IntersectionObserver((entries) => {
		entries.forEach((entry, i) => {
			if (entry.isIntersecting) {
				setTimeout(() => entry.target.classList.add('visible'), i * 130);
				fadeObs.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15 });

	fadeEls.forEach(el => fadeObs.observe(el));

	if (slideEl) {
		const slideObs = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
					slideObs.unobserve(entry.target);
				}
			});
		}, { threshold: 0.1 });
		slideObs.observe(slideEl);
	}
</script>

<style>
	.about {
		padding: 7rem 3rem;
		background-color: var(--bg);
	}

	.about-wrap {
		max-width: 1100px;
		margin: 0 auto;
	}

	/* Section label */
	.section-label {
		font-family: var(--font-main);
		font-size: 1rem;
		font-weight: 500;
		color: var(--accent-orange);
		margin: 0 0 3.5rem;
		letter-spacing: 0.04em;
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 0.6s ease, transform 0.6s ease;
	}

	.section-label.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Grid */
	.about-grid {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 4.5rem;
		align-items: start;
	}

	/* Image column */
	.about-img-col {
		opacity: 0;
		transform: translateX(-36px);
		transition: opacity 0.85s ease, transform 0.85s ease;
	}

	.about-img-col.visible {
		opacity: 1;
		transform: translateX(0);
	}

	.about-img {
		width: 240px;
		display: block;
		border-radius: 12px;
	}

	/* Text column — animation is handled by [data-fade] rules */
	.about-text-col p {
		font-size: clamp(0.95rem, 1.7vw, 1.1rem);
		line-height: 1.8;
		color: #c8d0e0;
		margin: 0 0 1.5rem;
	}

	.about-text-col p:last-child { margin-bottom: 0; }

	/* data-fade shared */
	[data-fade] {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}

	[data-fade].visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 768px) {
		.about { padding: 5rem 1.5rem; }
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.about-img { width: 200px; margin: 0 auto; }
	}
</style>
