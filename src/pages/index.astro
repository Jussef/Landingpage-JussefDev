---
import Hero from '../components/Hero.astro';
import QuienSoy from '../components/sections/QuienSoy.astro';
import TechStack from '../components/sections/TechStack.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Social from '../components/sections/Social.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Hero />

	<!-- Contenido principal -->
	<main>
		<div class="parallax-zone">
			<TechStack />
			<QuienSoy />
			<Portfolio />
			<Social />
		</div>
	</main>
</Layout>

<style>
	.parallax-zone {
		position: relative;
		z-index: 0;
	}
</style>
